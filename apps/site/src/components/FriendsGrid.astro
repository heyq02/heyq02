---
import type { FriendsData } from '../lib/friends.ts'
import {
  siteBody,
  siteCardChrome,
  siteCardName,
  siteCardSummary,
  siteEmpty,
  siteH1,
  siteH2,
  siteHeaderRule,
  siteLink,
  sitePageRoot,
  sitePanelChrome,
  siteSection
} from '../lib/site-ui.ts'

interface Props {
  data: FriendsData
}

const { data } = Astro.props
const { title, intro, exchange, friends } = data

const avatarClass =
  'block size-12 shrink-0 rounded-full border border-[var(--site-divider-light)] bg-[var(--site-bg)] object-cover'
const friendCardClass = `group flex h-full items-center gap-[0.85rem] ${siteCardChrome}`
const exchangePanelClass = `mt-5 flex flex-col items-start gap-4 ${sitePanelChrome} sm:flex-row`
const fieldLabelClass =
  'm-0 font-[family-name:var(--site-mono)] text-[0.72rem] font-medium tracking-[0.06em] text-[var(--site-text-2)] uppercase'
const fieldValueClass = 'm-0 text-[0.95rem] leading-normal text-[var(--site-text-1)] wrap-anywhere'
const fieldRowClass =
  'grid grid-cols-1 items-baseline gap-x-3 gap-y-[0.15rem] sm:grid-cols-[4.5rem_1fr] sm:gap-y-2'
---

<div class:list={['friends', sitePageRoot]}>
  <header class={siteHeaderRule}>
    <h1 class={siteH1}>{title}</h1>
    <p class:list={['mt-3', siteBody]}>{intro}</p>
    <p
      class="mt-[0.45rem] mb-0 font-[family-name:var(--site-mono)] text-[0.78rem] font-medium tracking-[0.02em] text-[var(--site-text-2)]"
    >
      每次访问都会重新排序，换个顺序打个招呼。
    </p>
  </header>

  {
    friends.length === 0 ? (
      <p class:list={['friends-empty', siteSection, siteEmpty]}>还没有友链，等第一位朋友来交换。</p>
    ) : (
      <ul
        class:list={[
          'friends-grid',
          siteSection,
          'mb-0 grid list-none grid-cols-[repeat(auto-fill,minmax(15.5rem,1fr))] gap-3 p-0'
        ]}
        data-friends-grid
      >
        {friends.map(friend => (
          <li class="m-0 min-w-0">
            <a
              class={friendCardClass}
              href={friend.url}
              target="_blank"
              rel="noopener noreferrer friend"
              title={friend.name}
              aria-label={friend.desc ? `${friend.name} · ${friend.desc}` : friend.name}
              data-card=""
            >
              <img
                class={avatarClass}
                src={friend.avatar}
                alt=""
                width="48"
                height="48"
                loading="lazy"
                decoding="async"
              />
              <span class="grid min-w-0 gap-1">
                <span class:list={['truncate', siteCardName]}>{friend.name}</span>
                {friend.desc ? (
                  <span class:list={['line-clamp-2', siteCardSummary]}>{friend.desc}</span>
                ) : null}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }

  <section
    class:list={[
      'friends-exchange',
      siteSection,
      'border-t border-[var(--site-divider-light)] pt-8'
    ]}
  >
    <h2 class={siteH2}>{exchange.title}</h2>
    <p class={siteBody}>{exchange.body}</p>
    <div class={exchangePanelClass}>
      <img
        class={avatarClass}
        src={exchange.self.avatar}
        alt=""
        width="48"
        height="48"
        loading="lazy"
        decoding="async"
      />
      <dl class="m-0 grid min-w-0 gap-[0.55rem]">
        <div class={fieldRowClass}>
          <dt class={fieldLabelClass}>名称</dt>
          <dd class={fieldValueClass}>{exchange.self.name}</dd>
        </div>
        <div class={fieldRowClass}>
          <dt class={fieldLabelClass}>站点</dt>
          <dd class={fieldValueClass}>
            <a class={siteLink} href={exchange.self.url}>{exchange.self.url}</a>
          </dd>
        </div>
        <div class={fieldRowClass}>
          <dt class={fieldLabelClass}>头像</dt>
          <dd class={fieldValueClass}>
            <a class={siteLink} href={exchange.self.avatar}>{exchange.self.avatar}</a>
          </dd>
        </div>
        <div class={fieldRowClass}>
          <dt class={fieldLabelClass}>简介</dt>
          <dd class={fieldValueClass}>{exchange.self.desc}</dd>
        </div>
      </dl>
    </div>
  </section>
</div>

<script>
  const grid = document.querySelector('[data-friends-grid]')
  if (grid) {
    const items = Array.from(grid.children)
    for (let i = items.length - 1; i > 0; i -= 1) {
      const j = Math.floor(Math.random() * (i + 1))
      ;[items[i], items[j]] = [items[j]!, items[i]!]
    }
    for (const item of items) grid.append(item)
  }
</script>
