---
import { ThemeToggle } from './ThemeToggle.tsx'
import { intro } from '../lib/intro.ts'
import { navItems, socialOrder } from '../lib/nav.ts'

interface Props {
  currentPath: string
}

const { currentPath } = Astro.props

function isActive(href: string) {
  if (href === '/') {
    return currentPath === '/' || currentPath === '/index.html'
  }
  return currentPath === href || currentPath.startsWith(href)
}

const places = new Map(intro.places.map(place => [place.label, place]))
---

<header class="border-b border-[var(--site-divider-light)] bg-[color-mix(in_srgb,var(--site-bg)_92%,transparent)] backdrop-blur-md">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-5 gap-y-3 px-6 py-4 sm:px-8">
    <a href="/" class="flex items-center gap-2 no-underline" aria-label={intro.name}>
      <img src="/signature.png" alt="" width="28" height="28" class="size-7 dark:invert" />
      <span class="text-[0.95rem] font-semibold tracking-tight">{intro.name}</span>
    </a>

    <nav class="flex flex-1 flex-wrap items-center gap-x-4 gap-y-2 text-[0.92rem]" aria-label="主导航">
      {
        navItems.map(item => {
          const external = 'external' in item && item.external
          const active = !external && isActive(item.href)
          return (
            <a
              href={item.href}
              class:list={[
                'no-underline transition-colors',
                active ? 'font-semibold text-[var(--site-brand)]' : 'text-[var(--site-text-2)] hover:text-[var(--site-text-1)]'
              ]}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
            >
              {item.text}
            </a>
          )
        })
      }
    </nav>

    <div class="flex flex-wrap items-center gap-2">
      {
        socialOrder.map(label => {
          const place = places.get(label)
          if (!place) return null
          const isImg = place.href.startsWith('/')
          return isImg ? (
            <a
              href={place.href}
              class="text-[0.8rem] text-[var(--site-text-2)] no-underline hover:text-[var(--site-brand)]"
              title={label}
            >
              {label}
            </a>
          ) : (
            <a
              href={place.href}
              class="text-[0.8rem] text-[var(--site-text-2)] no-underline hover:text-[var(--site-brand)]"
              target="_blank"
              rel="noopener noreferrer"
              title={label}
            >
              {label}
            </a>
          )
        })
      }
      <ThemeToggle client:load />
    </div>
  </div>
</header>
