---
import BaseLayout from '../layouts/BaseLayout.astro'
import { formatCount, intro } from '../lib/intro.ts'
import { pinnedProjects } from '../lib/pinned.ts'
import { skillIconsPicture } from '../lib/skills-picture.ts'

const skills = skillIconsPicture(intro.skills)
const description = `${intro.name}。${[...intro.tags, intro.bio].join('，')}。`
---

<BaseLayout title={intro.name} description={description}>
  <header class="hero">
    <button type="button" class="poke" aria-label="戳一下头像" title="戳我" data-poke>
      <img src={intro.avatar} alt={intro.name} width="88" height="88" draggable="false" />
    </button>
    <div>
      <h1>{intro.name}</h1>
      <p class="muted" data-mood>{intro.kaomoji}</p>
      <p class="tags">{intro.tags.join(' · ')}</p>
      <p class="muted">{intro.bio}</p>
    </div>
  </header>

  <section>
    <h2>{intro.sections.education}</h2>
    {
      intro.education.map(item => (
        <article class="job">
          <h3>
            {item.school}
            <span class="meta">
              {' '}
              · {item.start} – {item.end}
            </span>
          </h3>
          <p class="muted">
            {item.degree} · {item.major}
          </p>
        </article>
      ))
    }
  </section>

  <section>
    <h2>{intro.sections.experience}</h2>
    {
      intro.experiences.map(job => (
        <article class="job">
          <h3>
            <a href={job.href}>{job.company}</a>
            <span class="meta">
              {' '}
              · {job.start} – {job.end}
            </span>
          </h3>
          <ul>
            {job.points.map(point => (
              <li>{point}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>

  <section>
    <h2>{intro.sections.openSource}</h2>
    <ul class="plain-list">
      {
        pinnedProjects.map(project => (
          <li>
            <a href={project.href}>
              <span class="title">{project.name}</span>
              <span class="meta">
                {' '}
                · {project.language} · {formatCount(project.stars)}★
              </span>
              {project.summary ? <span class="desc">{project.summary}</span> : null}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>{intro.sections.skills}</h2>
    <img class="skills" src={skills.src} alt={skills.alt} />
  </section>
</BaseLayout>

<script define:vars={{ moods: intro.moods }}>
  let index = 0
  const mood = document.querySelector('[data-mood]')
  document.querySelector('[data-poke]')?.addEventListener('click', () => {
    if (!moods.length || !mood) return
    index = (index + 1) % moods.length
    mood.textContent = moods[index] ?? ''
  })
</script>
