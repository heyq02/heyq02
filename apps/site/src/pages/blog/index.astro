---
import { getCollection } from 'astro:content'

import BaseLayout from '../../layouts/BaseLayout.astro'

const posts = (await getCollection('posts')).toSorted(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)
const interviews = (await getCollection('interview')).toSorted(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)

function formatDate(date: Date) {
  return date.toISOString().slice(0, 10)
}
---

<BaseLayout title="博客">
  <h1>博客</h1>
  <p class="muted">技术文章、开发笔记与面经整理。</p>

  <section>
    <h2>文章</h2>
    <ul class="plain-list">
      {
        posts.map(post => (
          <li>
            <a href={`/blog/posts/${post.id}/`}>
              <span class="title">{post.data.title}</span>
              <span class="meta"> · {formatDate(post.data.date)}</span>
              {post.data.description ? <span class="desc">{post.data.description}</span> : null}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>面经</h2>
    <ul class="plain-list">
      {
        interviews.map(post => (
          <li>
            <a href={`/blog/interview/${post.id}/`}>
              <span class="title">{post.data.title}</span>
              <span class="meta"> · {formatDate(post.data.date)}</span>
              {post.data.description ? <span class="desc">{post.data.description}</span> : null}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
