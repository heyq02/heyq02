---
import { getCollection } from 'astro:content'

import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  siteBody,
  siteCardChrome,
  siteCardName,
  siteCardSummary,
  siteH1,
  siteHeaderRule,
  sitePageRoot,
  siteSection,
  siteWhen
} from '../../lib/site-ui.ts'

const posts = (await getCollection('posts')).toSorted(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)

function formatDate(date: Date) {
  return date.toISOString().slice(0, 10)
}
---

<BaseLayout title="博客">
  <div class={sitePageRoot}>
    <header class={siteHeaderRule}>
      <h1 class={siteH1}>博客</h1>
      <p class:list={['mt-3', siteBody]}>精选技术笔记与项目记录。</p>
    </header>

    <section class={siteSection}>
      <ul class="m-0 grid list-none gap-3 p-0">
        {
          posts.map(post => (
            <li>
              <a class:list={['group grid gap-1', siteCardChrome]} href={`/blog/posts/${post.id}/`}>
                <span class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                  <span class={siteCardName}>{post.data.title}</span>
                  <time class={siteWhen} datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date)}
                  </time>
                </span>
                {post.data.description ? (
                  <span class={siteCardSummary}>{post.data.description}</span>
                ) : null}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
