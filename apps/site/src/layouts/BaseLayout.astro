---
import { intro } from '../lib/intro.ts'
import { navItems } from '../lib/nav.ts'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const { title, description = intro.description } = Astro.props
const pageTitle = title ? `${title} · ${intro.name}` : `${intro.name} · ${intro.bio}`
const path = Astro.url.pathname

function current(href: string) {
  if (href === '/') return path === '/' || path === '/index.html'
  return path === href || path.startsWith(href)
}
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={intro.name} />
    <meta name="description" content={description} />
    <meta property="og:site_name" content={intro.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={intro.avatar} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${intro.name} · 博客`}
      href="/blog/rss.xml"
    />
    <title>{pageTitle}</title>
    <script is:inline>
      ;(() => {
        const key = 'heyq02-theme'
        const stored = localStorage.getItem(key)
        const dark = stored
          ? stored === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.classList.toggle('dark', dark)
      })()
    </script>
  </head>
  <body>
    <div class="wrap">
      <nav class="nav" aria-label="主导航">
        <a class="nav-brand" href="/">{intro.name}</a>
        {
          navItems.map(item => {
            const external = 'external' in item && item.external
            return (
              <a
                href={item.href}
                aria-current={!external && current(item.href) ? 'page' : undefined}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                {item.text}
              </a>
            )
          })
        }
        <div class="nav-end">
          {
            intro.places.map(place => (
              <a
                href={place.href}
                target={place.href.startsWith('/') ? undefined : '_blank'}
                rel={place.href.startsWith('/') ? undefined : 'noopener noreferrer'}
              >
                {place.label}
              </a>
            ))
          }
          <button type="button" class="theme-btn" data-theme-toggle aria-label="切换浅色 / 深色">
            深色
          </button>
        </div>
      </nav>

      <main>
        <slot />
      </main>

      <footer class="footer">
        © {new Date().getFullYear()}
        {intro.name} ·
        <a href="https://icp.gov.moe/?keyword=20260869" target="_blank" rel="noopener noreferrer">
          萌ICP备20260869号
        </a>
      </footer>
    </div>

    <script>
      const key = 'heyq02-theme'
      const button = document.querySelector('[data-theme-toggle]')
      const sync = () => {
        const dark = document.documentElement.classList.contains('dark')
        if (!button) return
        button.textContent = dark ? '浅色' : '深色'
      }
      sync()
      button?.addEventListener('click', () => {
        const next = !document.documentElement.classList.contains('dark')
        document.documentElement.classList.toggle('dark', next)
        localStorage.setItem(key, next ? 'dark' : 'light')
        sync()
      })
    </script>
  </body>
</html>
