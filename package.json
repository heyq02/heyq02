{
  "name": "heyq02-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "check": "vp run ccheck",
    "commitlint": "commitlint",
    "dev": "vp -C apps/site dev",
    "format": "vp run cfmt",
    "format:check": "vp fmt --check",
    "lint": "vp run clint",
    "lint:fix": "vp lint --fix",
    "prepare": "vp config",
    "release": "bumpp apps/cli/package.json",
    "test": "vp -C apps/cli run ctest",
    "test:coverage": "vp -C apps/cli test --coverage"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@liangmi/vp-config": "catalog:",
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "sponsorkit": "19.0.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.10.1"
}
