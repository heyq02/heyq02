{
  "name": "heyq02",
  "version": "0.1.2",
  "description": "永琪（Ari），全栈研发。终端里的个人介绍。",
  "homepage": "https://intro.heyq02.com",
  "bugs": {
    "url": "https://github.com/heyq02/heyq02/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyq02/heyq02.git"
  },
  "license": "MIT",
  "author": "永琪（Ari） <hello@heyq02.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "heyq02": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rs lib",
    "build:rsdoctor": "RSDOCTOR=true rs lib",
    "check": "rs check && pnpm run typecheck",
    "commitlint": "commitlint",
    "dev": "rs lib --watch",
    "format": "rs fmt",
    "format:check": "rs fmt --check",
    "lint": "rs lint .",
    "lint:fix": "rs lint --fix .",
    "prepare": "rs hooks",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp",
    "test": "rs test",
    "test:coverage": "rs test --coverage",
    "typecheck": "tsc6 --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@bomb.sh/router": "0.8.0",
    "ink": "^8.0.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@heyq02/rstack-config": "^0.0.6",
    "@microsoft/api-extractor": "^7.59.4",
    "@rsdoctor/rspack-plugin": "^1.6.5",
    "@rslib/core": "^1.0.3",
    "@rslint/core": "^0.9.5",
    "@rstest/core": "^0.12.3",
    "@rstest/coverage-v8": "^0.12.3",
    "@types/node": "^26.1.1",
    "@types/react": "19.3.0",
    "bumpp": "^11.1.0",
    "ink-testing-library": "^4.0.0",
    "oxfmt": "^0.73.0",
    "rstack": "^0.8.4",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "vite-plus": "^1.3.0"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
